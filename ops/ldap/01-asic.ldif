# An organizational tree standing in for Active Directory, in the same six-directorate shape the
# demo dataset uses — so the LDAP adapter and the sync reconciliation can be developed end to end
# without a domain controller.

dn: dc=asic,dc=army,dc=mil
objectClass: dcObject
objectClass: organization
o: ASIC
dc: asic

dn: ou=OCIO,dc=asic,dc=army,dc=mil
objectClass: organizationalUnit
ou: OCIO

dn: ou=Governance,ou=OCIO,dc=asic,dc=army,dc=mil
objectClass: organizationalUnit
ou: Governance

dn: ou=Policy,ou=Governance,ou=OCIO,dc=asic,dc=army,dc=mil
objectClass: organizationalUnit
ou: Policy

dn: ou=Cyber,dc=asic,dc=army,dc=mil
objectClass: organizationalUnit
ou: Cyber

dn: ou=Operations,ou=Cyber,dc=asic,dc=army,dc=mil
objectClass: organizationalUnit
ou: Operations

dn: ou=SOC,ou=Operations,ou=Cyber,dc=asic,dc=army,dc=mil
objectClass: organizationalUnit
ou: SOC

