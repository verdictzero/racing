# Copy to .env and adjust. Every value here works as-is against `docker compose up -d`.
# ---------------------------------------------------------------------------------------------

# ---- Database -------------------------------------------------------------------------------
DATABASE_URL=postgres://raci:raci_dev_password@localhost:5432/raci

# ---- Session --------------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-in-every-real-deployment

# ---- Identity provider ------------------------------------------------------------------------
# The app speaks plain OIDC discovery and does not care which provider is behind it. Point
# AUTH_OIDC_ISSUER at any compliant IdP and the rest is negotiated from its discovery document.
#
# Keycloak (the local stack, and the on-prem / air-gapped default):
AUTH_OIDC_ISSUER=http://localhost:8080/realms/raci
AUTH_OIDC_CLIENT_ID=raci-web
AUTH_OIDC_CLIENT_SECRET=raci-web-dev-secret
AUTH_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
AUTH_OIDC_SCOPES=openid profile email
AUTH_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
#
# EntraID (Azure / Azure Gov) — swap these in, change nothing else:
#   AUTH_OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
#   AUTH_OIDC_CLIENT_ID=<APP_REGISTRATION_CLIENT_ID>
#   AUTH_OIDC_CLIENT_SECRET=<CLIENT_SECRET>
#   AUTH_OIDC_SCOPES=openid profile email offline_access
# Azure Gov uses login.microsoftonline.us and a different Graph host; see AUTH_GRAPH_BASE_URL.

# Where the role claim lives. Keycloak puts realm roles under realm_access.roles; EntraID app
# roles arrive as a flat `roles` array. Dotted path, resolved against the ID token claims.
AUTH_ROLES_CLAIM=realm_access.roles
# Claim used as the stable external user id. Never the email — addresses get reassigned.
AUTH_SUBJECT_CLAIM=sub

# Maps the IdP's own role names onto this app's three roles. WITHOUT THIS EVERY USER IS A VIEWER —
# logins still succeed, but nothing can be created or edited, which looks like a broken app rather
# than a missing setting. The keys below are the roles the seeded Keycloak realm grants.
AUTH_ROLE_MAP={"raci-viewer":"viewer","raci-editor":"editor","raci-admin":"admin"}
# EntraID app roles instead, for example:
#   AUTH_ROLE_MAP={"RACI.Viewer":"viewer","RACI.Editor":"editor","RACI.Admin":"admin"}

# ---- Directory sync (the org chart source) ----------------------------------------------------
# One of: ldap | graph | csv | none
DIRECTORY_PROVIDER=ldap

# --- ldap (Active Directory, or the OpenLDAP in the dev stack) ---
DIRECTORY_LDAP_URL=ldap://localhost:1389
DIRECTORY_LDAP_BIND_DN=cn=admin,dc=asic,dc=army,dc=mil
DIRECTORY_LDAP_BIND_PASSWORD=ldap_dev_password
DIRECTORY_LDAP_BASE_DN=dc=asic,dc=army,dc=mil
DIRECTORY_LDAP_USER_FILTER=(&(objectClass=inetOrgPerson))
DIRECTORY_LDAP_GROUP_FILTER=(objectClass=organizationalUnit)
# Against a real AD, set: USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
# TLS: use ldaps:// and point at the CA bundle rather than disabling verification.
DIRECTORY_LDAP_TLS_CA_FILE=

# --- graph (EntraID / Microsoft 365) ---
DIRECTORY_GRAPH_TENANT_ID=
DIRECTORY_GRAPH_CLIENT_ID=
DIRECTORY_GRAPH_CLIENT_SECRET=
# Commercial: https://graph.microsoft.com  ·  Azure Gov: https://graph.microsoft.us
DIRECTORY_GRAPH_BASE_URL=https://graph.microsoft.com

# --- csv (air-gapped drops, and the fixture used by the tests) ---
# Resolved against the SERVER PROCESS's working directory, which is apps/web when started by
# `pnpm dev` — not the repository root. Use an absolute path in any real deployment.
DIRECTORY_CSV_PATH=../../ops/directory/sample-org.csv

# Cron for the scheduled sync. Empty disables it; the sync can always be run by hand.
DIRECTORY_SYNC_CRON=0 3 * * *

# ---- Realtime collaboration -------------------------------------------------------------------
# Websocket endpoint the Yjs provider connects to. Same origin in production.
COLLAB_WS_URL=ws://localhost:3000/api/collab
# How many Yjs updates accumulate before the server writes a compacted snapshot.
COLLAB_SNAPSHOT_EVERY=200

# ---- App --------------------------------------------------------------------------------------
NUXT_PUBLIC_APP_NAME=ASIC RACI Tool
LOG_LEVEL=info

# Which source unit becomes which directorate, as JSON. Keys are ACTOR keys; values match a unit's
# own name or leading DN component (case-insensitive). Without this, units map purely by depth.
#   DIRECTORY_TIER_MAPPING={"directorates":{"ocio":"OU=OCIO","cyber":"OU=Cyber"},"exclude":["OU=Service Accounts"]}
DIRECTORY_TIER_MAPPING=
